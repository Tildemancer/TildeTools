<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.5.0</Version>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)\..\build\TildeTools</OutputPath>
  </PropertyGroup>

  <!-- The forks, referenced from their submodules: one plugin to install, and each fork stays a rebase onto upstream -->
  <ItemGroup>
    <ProjectReference Include="..\ct\ChatTwo\ChatTwo.csproj" />
    <ProjectReference Include="..\xim\Messenger\Messenger.csproj" />
    <ProjectReference Include="..\ws\Wordsmith\Wordsmith.csproj" />
  </ItemGroup>

  <!--
    Chat 2 unzips its web pages into its own output folder, not ours
    Without them its server logs an error on every load
  -->
  <Target Name="CopyChatTwoFrontend" AfterTargets="Build">
    <Unzip SourceFiles="$(MSBuildProjectDirectory)\..\ct\ChatTwo\websiteBuild.zip" DestinationFolder="$(TargetDir)Frontend" />
  </Target>

  <!-- Chat 2's SQLite brings its native library for every platform, and the game only ever loads win-x64's -->
  <Target Name="DropOtherRuntimes" AfterTargets="Build" BeforeTargets="DefaultDalamudPackagerRelease;DefaultDalamudPackagerDebug" Condition="Exists('$(TargetDir)runtimes')">
    <ItemGroup>
      <RuntimeFolder Include="$([System.IO.Directory]::GetDirectories('$(TargetDir)runtimes'))" />
    </ItemGroup>
    <RemoveDir Directories="@(RuntimeFolder)" Condition="'%(Filename)' != 'win-x64'" />
  </Target>

  <!--
    The spellchecker's dictionaries in Hunspell's affix format, shipped so it works the same everywhere
    en_US is SCOWL's, with COPYRIGHT-SCOWL.txt beside it as its licence asks
    en_GB is David Bartlett, Andrew Brown and Marco A.G. Pinto's, under the LGPL 2.1, less en_US's words
    Its notice is in en_GB.aff, and its licence travels as COPYING-LGPL-2.1.txt
  -->
  <ItemGroup>
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
    <Content Include="Dictionaries\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Definitions from Wiktionary, synonyms from Open English WordNet and Wiktionary
    Read from disk only when looked up, their notices alongside
  -->
  <ItemGroup>
    <Content Include="Lexicon\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- My Chat 2 and Messenger settings, scrubbed: see ShippedSetup -->
  <ItemGroup>
    <EmbeddedResource Include="Defaults\*.json" />
  </ItemGroup>

  <!-- Drives the generated manifest that Dalamud reads when loading the plugin -->
  <PropertyGroup>
    <Author>Tildemancer</Author>
    <Name>TildeTools</Name>
    <Punchline>A box of small tools, each switched on or off on its own.</Punchline>
    <Description>A collection of tools under one window, each with its own tab and master switch. Includes Emote Splitter, which raises the chat box's length limit and sends long messages as paced parts so the server does not drop them, and spellcheck.</Description>
    <Tags>Social;Utility;Roleplay</Tags>
    <IconUrl>https://raw.githubusercontent.com/Tildemancer/TildeTools/master/TildeTools/images/icon.png</IconUrl>
  </PropertyGroup>

</Project>
